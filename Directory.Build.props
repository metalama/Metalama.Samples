<Project>

    <PropertyGroup>
        <RepoDirectory>$(MSBuildThisFileDirectory)</RepoDirectory>
        <RepoKind>GitHub</RepoKind>


        <!-- Evaluation license key restricted to the Metalama.Samples namespace. -->
        <MetalamaLicense>112792-QQXG8QQQSTAEQ2WEV4LLX7HRSQWMYBGVA28ZNNSRVJYZNNAVR4JX3SQSCZ7VM3WDWRT5VL4G9Z7DPCWRE94MM2YRV2CFKS657VAFMGE3C9NKMRCGN8AXWLZV4QQXGQYZATP4Q8USJG4X6P2</MetalamaLicense>

        <!-- Intentionally removing any ambiant license key to make sure that we can build without one. -->
        <MetalamaIgnoreMetalamaIgnoreUserLicenses>True</MetalamaIgnoreMetalamaIgnoreUserLicenses>
    </PropertyGroup>

    <Import Project="eng\Versions.props"/>
    <Import Project="eng\Packaging.props"/>
    <Import Sdk="PostSharp.Engineering.Sdk" Project="BuildOptions.props" Condition="Exists('global.json')"/>
    <Import Sdk="PostSharp.Engineering.Sdk" Project="SourceLink.props" Condition="Exists('global.json')"/>

    <PropertyGroup>
        <NoWarn>LAMA0048;CA1050;LAMA0066</NoWarn>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>False</IsPackable>

        <!-- HTML files are consumed by Metalama.Documentation. -->
        <MetalamaWriteHtml>True</MetalamaWriteHtml>

        <!-- We want samples to be compatible with VS 2022. -->
        <LangVersion>13.0</LangVersion>
        
        <!-- These properties are redundant with BuildOptions.props but this file is not imported on end-user machines 
             where global.json is not present.  -->
        <LangVersion Condition="'$(LangVersion)'==''">latest</LangVersion>
        <Nullable>enable</Nullable>

        <!-- Enable build on non-Windows machines. -->
         <EnableWindowsTargeting>True</EnableWindowsTargeting>

        <!-- The tests are written with xunit.v3 and are run by VSTest (xunit.runner.visualstudio), because the build
             runs 'dotnet test' in its VSTest mode. xunit.v3 declares a test project to be a Microsoft.Testing.Platform
             application by default, and the .NET 10 SDK refuses such a project in the VSTest mode. The property has
             no effect on a project that does not reference xunit.v3. -->
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>

    </PropertyGroup>

</Project>