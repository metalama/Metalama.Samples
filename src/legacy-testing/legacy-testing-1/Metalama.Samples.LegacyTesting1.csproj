<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Configurations>Debug;Release;Test</Configurations>
    </PropertyGroup>

    <!-- The Test configuration is the build that the tests use. The TEST_SEAMS symbol enables the interceptors. -->
    <PropertyGroup Condition="'$(Configuration)'=='Test'">
        <DefineConstants>$(DefineConstants);TEST_SEAMS</DefineConstants>

        <!-- The documentation uses the HTML files of the default build. -->
        <MetalamaWriteHtml>False</MetalamaWriteHtml>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Metalama.Framework"/>
        <PackageReference Include="Metalama.Extensions.Interceptors"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="reminder-template.txt" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
