<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <!-- The tests use the Test configuration of the legacy project, in which the interceptors replay the recorded
         interactions. -->
    <ItemGroup>
        <ProjectReference Include="..\..\legacy-testing\legacy-testing-3\Metalama.Samples.LegacyTesting3.csproj"
                          AdditionalProperties="Configuration=Test"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="Recordings\*.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!-- The snapshots are read from, and written to, the source directory. -->
    <ItemGroup>
        <AssemblyMetadata Include="ProjectDirectory" Value="$(MSBuildProjectDirectory)"/>
    </ItemGroup>

</Project>
