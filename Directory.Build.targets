<Project>
    <!--
        SampleProjectKind determines which Metalama extension packages to include:
        - (default/empty): Include HtmlWriter only (for sample projects using Metalama)
        - TestProject: Include both HtmlWriter and DiffEngine (for test projects)
        - Regular: Don't include any Metalama extensions (for non-Metalama projects)
    -->

    <!-- Documentation generation for all Metalama sample projects -->
    <ItemGroup Condition="'$(SampleProjectKind)' != 'Regular'">
        <PackageReference Include="Metalama.Extensions.HtmlWriter" />
    </ItemGroup>

    <!-- Test convenience - launches diff tools when test output differs from expected -->
    <ItemGroup Condition="'$(SampleProjectKind)' == 'TestProject'">
        <PackageReference Include="Metalama.Extensions.DiffEngine" />
    </ItemGroup>
</Project>
